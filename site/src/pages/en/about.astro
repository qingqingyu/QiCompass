---
// 关于与方法页(S05 站务页,E-E-A-T 核心):确定性引擎 / 真太阳时 / 23:00 换日 /
// 三命通会查表 / AI 起草 + 引擎核对 + 人工过目。只陈述、不玄夸。
import Base from "../../layouts/Base.astro";
import { type Lang } from "../../data/site";

const lang: Lang = "en";
const path = "/en/about";

const method = [
  {
    h: "A deterministic engine",
    zh: "确定性引擎",
    p: "Every chart is computed by rules, not vibes: the same birth data always produces the same chart, and the calculation rules are pinned to a version. When we change a rule, we say so.",
  },
  {
    h: "True Solar Time",
    zh: "真太阳时",
    p: "Clock time is converted to local solar time using the birthplace's longitude and the equation of time, before the hour pillar is picked. Historical time zones and daylight saving are applied first.",
  },
  {
    h: "The 23:00 day boundary",
    zh: "子初换日",
    p: "The Chinese day begins at the start of the Rat hour, 23:00 — no \"early\" and \"late\" Rat split. A birth at 23:30 belongs to the next day's pillar. One rule, applied to every chart.",
  },
  {
    h: "Solar-term months",
    zh: "节气定月",
    p: "The month pillar changes on the 12 \"jie\" solar terms, not on the lunar first. A birth on 3 February may still carry the previous year's pillar.",
  },
] as const;

const honesty = [
  "The language model never decides favorable or unfavorable elements. It only phrases what the rules engine computed. If it ever disagrees with the engine, the engine wins.",
  "No hard \"structure\" labels (正官格 and friends). The chart is described in plain tendencies; readers who know the tradition will recognize the shapes without us putting a stamp on them.",
  "When a chart falls into an edge case the rules treat specially (a \"follow\" pattern), the app says so plainly instead of guessing a favorable element.",
  "No doom. No death dates, no lottery numbers, no \"marry in your 30th year.\" A reading that can be right either way is not a reading.",
] as const;
---

<Base
  {lang}
  title="About & method — how KnowFate casts and reads a BaZi chart"
  description="How KnowFate - Chinese Astrology works: a deterministic chart engine with True Solar Time and the 23:00 day boundary, symbolic stars from Sanming Tonghui, and readings where the language model phrases but never judges."
  path={path}
>
  <div class="wrap">
    <ol class="crumbs">
      <li><a href="/en">Home</a></li>
      <li aria-current="page">About &amp; method</li>
    </ol>

    <header class="calc-head">
      <div>
        <h1 class="h1">About &amp; method <span class="muted" style="font-style:italic;font-weight:300;display:block">Professional, not fortune-telling.</span></h1>
        <p class="lede muted">KnowFate - Chinese Astrology casts BaZi charts with a deterministic engine and reads them with care. This page records exactly how the chart is cast, how the reading is written, and what we refuse to claim.</p>
      </div>
      <span class="vtext" aria-hidden="true">观命</span>
    </header>
  </div>

  <section class="section-tight" style="padding-top:0">
    <div class="wrap" style="max-width:880px">
      <div class="section-head">
        <span class="vmark" aria-hidden="true">排盘法度</span>
        <div>
          <span class="kicker">Method</span>
          <h2 class="h2" style="margin-top:14px">How the chart is cast</h2>
        </div>
      </div>
      <div class="method" style="max-width:none">
        {method.map((m) => (
          <div>
            <h3>{m.h} <span class="zh">{m.zh}</span></h3>
            <p>{m.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="wrap" style="max-width:760px">
      <div class="section-head">
        <span class="vmark" aria-hidden="true">解读成文</span>
        <div>
          <span class="kicker">The reading</span>
          <h2 class="h2" style="margin-top:14px">How the reading is written</h2>
        </div>
      </div>
      <p class="muted" style="max-width:40em">Chapters are drafted by a language model, then checked against the engine's output line by line — the Ten Gods, the balance of the Five Elements, the symbolic stars. A human reviews the wording before it ships. Three steps, one rule: the chart decides, the words obey.</p>
      <ul class="honesty" style="margin:26px 0 0;padding:0;list-style:none">
        {honesty.map((h) => (
          <li style="border-top:1px solid var(--hairline);padding:16px 0;color:var(--ink-muted);font-size:15.5px">{h}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" style="padding-top:0">
    <div class="wrap" style="max-width:760px">
      <div class="section-head">
        <span class="vmark" aria-hidden="true">出处</span>
        <div>
          <span class="kicker">Sources</span>
          <h2 class="h2" style="margin-top:14px">Sources &amp; references</h2>
        </div>
      </div>
      <p class="muted" style="max-width:40em">Calendar conversion runs on a maintained open-source engine, verified against a corpus of published reference charts before every release. Symbolic stars (神煞) follow one fixed table from <em>Sanming Tonghui</em> (《三命通会》) — eleven auspicious, nine inauspicious, no ad-hoc additions. Schools are never mixed on one chart.</p>
      <p class="caption" style="margin-top:18px">Try the chart engine yourself in the <a href="/en/bazi-calculator">free BaZi calculator</a>, or see <a href="/en/app">what the app reads</a>. Data handling: <a href="/en/privacy">Privacy</a>.</p>
    </div>
  </section>
</Base>
