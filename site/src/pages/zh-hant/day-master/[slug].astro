---
// 日主页 zh-hant 腿(与 en 腿同构;发布门槛 = 双腿同批,S03 只交 en 样张草稿)。
import { getCollection } from "astro:content";
import DayMasterPage from "../../../components/DayMasterPage.astro";

export async function getStaticPaths() {
  const all = await getCollection("day-master");
  const preview = process.env.SITE_PREVIEW_DRAFTS === "1";
  return all
    .filter((e) => e.data.lang === "zh-hant" && (preview || e.data.published))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---

<DayMasterPage {entry} />
