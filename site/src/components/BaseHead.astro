---
// 每页 <head> 唯一入口:title / description / canonical / hreflang 三条 / OG / Twitter /
// theme-color 双值 / robots / JSON-LD 插槽 / 字体 preload。
// canonical 与 hreflang 一律无尾斜杠(规格 README §3;设计稿 home.html 的 `/en/` 带斜杠以规格为准)。
import { SITE, stripLang, langPath, type Lang } from "../data/site";
import { CONFIG } from "../config.mjs";

interface Props {
  title: string;
  description: string;
  /** 当前页完整路径(带语言前缀,可带尾斜杠,内部归一化) */
  path: string;
  lang: Lang;
  /** 构建产物示例页等:robots noindex(默认连带 nofollow) */
  noindex?: boolean;
  /** S06 带参数排盘结果页:noindex 但允许跟踪链接(noindex, follow)时传 false */
  nofollow?: boolean;
  /** og:image 绝对 URL(S06 生成后传入);缺省不出 og:image */
  ogImage?: string;
  /** og:type;知识文章页传 "article"(S03 ArticleLayout),其余保持默认 website */
  ogType?: "website" | "article";
  /** ogType = article 时的 article:modified_time(日期 YYYY-MM-DD,补 T00:00:00Z) */
  articleModified?: string;
}

const { title, description, path, lang, noindex = false, nofollow = true, ogImage,
        ogType = "website", articleModified } = Astro.props;

const canonicalPath = path.replace(/\/+$/, "") === "" ? "/" : path.replace(/\/+$/, "");
const canonical = SITE.domain + (canonicalPath === "/" ? "" : canonicalPath);
const { rest } = stripLang(path);
const altEn = SITE.domain + langPath("en", rest);
const altHant = SITE.domain + langPath("zh-hant", rest);

const brand = SITE.brand[lang];
// 品牌后缀拼接(规格 §6):主词 ≤60 字符才加后缀;超长(60+)裸出主词——
// 加了必超搜索摘要截断线,且规格要求超长时去后缀(2026-11-27 外评修复)。
// 拼接后总长(主词 + 空格 + 后缀)≤ 60 才加后缀(2026-11-28 外评更正:
// 原实现只看主词自身,55 字符主词 + 后缀 = 66 超限;规格原义是整体不超 60)
const withSuffix = `${title} ${brand.titleSuffix}`;
const fullTitle = title.includes(brand.titleSuffix) || withSuffix.length > 60
  ? title
  : withSuffix;

const themeLight = "#E7E2D5";
const themeDark = "#171412";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content={nofollow === false ? "noindex, follow" : "noindex, nofollow"} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={altEn} />
<link rel="alternate" hreflang="zh-Hant" href={altHant} />
<link rel="alternate" hreflang="x-default" href={altEn} />
{/* S06 规格第 3 条:带出生参数的 URL(?d= 日期 / ?t= 时辰 / ?c= 城市)
    输出 noindex,follow + canonical 指向干净 URL(上面 canonical 渲染的
    就是干净 URL)。二期排盘器才产生这类地址,一期先把机制备好:客户端
    检测到参数即注入 robots meta;页面自身已有 robots meta(如 noindex
    示例页)则不覆盖。检测走 URLSearchParams(2026-11-28 review:原 regex
    [?&](d|t|c)= 已覆盖 ?d= 与 &d= 两种位置,漏的是百分号编码键——%64=
    这种形态 regex 不认,URLSearchParams 解码后 has("d") 命中)。注释与
    文案只用英文——本内联脚本会随 en 页面进产物,中文字面会被字体 SC 腿
    (扫 dist)当正文用字收进子集。 */}
<script is:inline>
(function () {
  if (typeof URLSearchParams !== "function") return;
  var q = new URLSearchParams(location.search);
  if (!(q.has("d") || q.has("t") || q.has("c"))) return;
  if (document.querySelector('meta[name="robots"]')) return;
  var m = document.createElement("meta");
  m.name = "robots";
  m.setAttribute("content", "noindex, follow");
  document.head.appendChild(m);
})();
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content={themeLight} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={themeDark} media="(prefers-color-scheme: dark)" />
<meta property="og:type" content={ogType} />
{ogType === "article" && articleModified && (
  <meta property="article:modified_time" content={`${articleModified}T00:00:00Z`} />
)}
<meta property="og:site_name" content={lang === "en" ? "KnowFate" : "觀命 KnowFate"} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === "en" ? "en_US" : "zh_TW"} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{/* Newsreader 400 是标题字体,en 页 LCP 元素即它,全页 preload。
    zh-hant 页 LCP 是中文 h1(knowfate-tc 渲染,365KB):浏览器要等 CSS 解析 +
    首次排版才知道需要该字体,S04 Lighthouse 实测 ~550ms 才起跑,preload 提前到
    t≈0;en 页 SC 子集只点缀 kicker 字样(非 LCP),不 preload 避免抢首屏带宽。 */}
<link rel="preload" href="/fonts/newsreader-400.woff2" as="font" type="font/woff2" crossorigin />
{lang === "zh-hant" && <link rel="preload" href="/fonts/knowfate-tc.woff2" as="font" type="font/woff2" crossorigin />}
{/* 尽早打上 .js 标记,滚动揭示(.js .reveal)才不会闪烁;真正的增强在打包后的 enhance.ts */}
<script is:inline>document.documentElement.classList.add("js");</script>
{/* S06 TelemetryDeck Web SDK(无 cookie):appId 空占位时不输出标签,
    页面零第三方外联;注册后只填 config.mjs 一处。自定义事件(CTA 点击/
    邮箱提交)在 enhance.ts 里经 tdSignal 发,SDK 未加载时静默不发。 */}
{CONFIG.telemetry.appId && (
  <script is:inline async src="https://cdn.telemetrydeck.com/websdk/telemetrydeck.min.js" data-app-id={CONFIG.telemetry.appId}></script>
)}
<slot />
