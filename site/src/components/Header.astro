---
// 页头:品牌字按语言(规格 README §13)+ 主导航 + 语言切换 + 移动端菜单按钮。
// 当前页朱点 = aria-current="page" 的 ::after 菱形(global.css §6,DESIGN 允许的当前时辰点级朱红)。
import { SITE, UI, NAV, isLaunched, langPath, stripLang, zhFamily, type Lang } from "../data/site";

interface Props {
  lang: Lang;
  /** 当前页路径(带语言前缀),用于 aria-current 与语言切换目标 */
  path: string;
}

const { lang, path } = Astro.props;
const t = UI[lang];
const brand = SITE.brand[lang];
const { rest } = stripLang(path);

const currentPath = path.replace(/\/+$/, "");
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href={langPath(lang, "/")} aria-label={t.homeAria}>
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M23.5 6.2A12 12 0 1 0 27.6 19" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><rect x="21.5" y="20.5" width="6" height="6" rx="1" fill="var(--cinnabar)" transform="rotate(-4 24.5 23.5)"/></svg>
      {lang === "en" ? (
        <span class="brand-word">{brand.word}</span>
      ) : (
        <span style="display:grid;gap:4px">
          <span class="brand-zh">{brand.word}</span>
          <span class="brand-sub">KNOWFATE</span>
        </span>
      )}
    </a>
    <nav class="nav" id="nav" aria-label={t.navAria}>
      {/* 未上线区块灰显不出链接(TASK-18:开关唯一事实源 launch.json,
          按每条链接的 rest 路径判 isLaunched;防搜索引擎撞 404) */}
      {NAV.map((item) =>
        isLaunched(item.path) ? (
          <a href={langPath(lang, item.path)} aria-current={currentPath === langPath(lang, item.path) ? "page" : undefined}>
            {t.nav[item.key]}
          </a>
        ) : (
          <span class="nav-item not-launched" aria-disabled="true" title={t.comingSoon}>{t.nav[item.key]}</span>
        ),
      )}
    </nav>
    <div class="header-right">
      <div class="lang">
        {/* 语言切换:每枚标签链到自己语言的对应页(与页脚同一套语义);
            aria-current 标在「当前语言」那枚上。EN 标签恒在左,繁在右。 */}
        <a href={langPath("en", rest)} hreflang="en" aria-current={lang === "en" ? "true" : undefined}>
          {lang === "en" ? t.langSwitch.current : t.langSwitch.other}
        </a>
        <span aria-hidden="true">·</span>
        {/* en 页面繁字用 SC 腿渲染(.tc 会拉起 241KB TC 字体,为一枚字不值得);
            zh-hant 页面整页已是 TC 字体族 */}
        <a href={langPath("zh-hant", rest)} hreflang="zh-Hant" aria-current={lang === "zh-hant" ? "true" : undefined} lang={lang === "en" ? "zh-Hant" : undefined} class={zhFamily(lang)}>
          {lang === "en" ? t.langSwitch.other : t.langSwitch.current}
        </a>
      </div>
      {isLaunched("/app") ? (
        <a class="btn btn-sm" href={langPath(lang, "/app")}>{t.getTheApp}<span class="seal-dot" aria-hidden="true"></span></a>
      ) : (
        <span class="btn btn-sm not-launched" aria-disabled="true" title={t.comingSoon}>{t.getTheApp}<span class="seal-dot" aria-hidden="true"></span></span>
      )}
      <button class="menu-btn" aria-controls="nav" aria-expanded="false" aria-label={t.menuLabel}><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
    </div>
  </div>
</header>
