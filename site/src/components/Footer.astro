---
// 页脚 = 全站内链枢纽(设计稿 home.html §14;链接列表从数据生成)。
// 术语列(日主/十神/五行/神煞)自 S02 起取 terms.json 单一事实源(2026-11-27
// 外评修复兑现 S01 预留注释):名字按语言取 en / zhHant,路径取后端导出值,
// 不在站点另起译名(术语单一事实源红线)。
// 未上线区块灰显不出 <a>(LAUNCH 开关,同 Header;防搜索引擎首抓撞 404)。
import { SITE, UI, LAUNCH, langPath, stripLang, zhFamily, type Lang } from "../data/site";
import terms from "../data/terms.json";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = UI[lang];
const brand = SITE.brand[lang];
const { rest } = stripLang(path);

// 链接路径一律 rest 形态(不带语言前缀),经 langPath 补当前语言前缀
const P = (p: string) => langPath(lang, p);

const g = terms.groups;
const nameOf = (e: { en: string; zhHant: string }) => (lang === "en" ? e.en : e.zhHant);
const dayMasters = Object.entries(g.heavenlyStems) as [string, { en: string; zhHant: string; path: string }][];
// 天干按五行拼展示名(2026-11-28 外评建议):术语表天干值是单字(甲),
// 页脚列拼成「甲木 / Jia Wood」更好懂。干支→五行为常识映射,非译名,
// 不属术语单一事实源管辖(值仍取 terms.json 的 element 译名)。
const STEM_ELEMENT: Record<string, string> = { 甲: "木", 乙: "木", 丙: "火", 丁: "火", 戊: "土", 己: "土", 庚: "金", 辛: "金", 壬: "水", 癸: "水" };
const stemName = (key: string, e: { en: string; zhHant: string }) => {
  const el = g.fiveElements[STEM_ELEMENT[key]];
  return lang === "en" ? `${e.en} ${el.en}` : `${e.zhHant}${el.zhHant}`;
};
// 偏官与七杀同页(en 名与 path 均同 /ten-gods/seven-killings)——按 path 去重
// 取首个(七杀在前),页脚保持 10 条;全量渲染会出现两条同名同址链接。
const tenGods = [...new Map(Object.values(g.tenGods).map((x) => [x.path, x])).values()];
const elements = Object.values(g.fiveElements);
// 页脚只列 5 个代表神煞(设计稿口径);按导出 path 稳定挑选,不依赖中文键名。
// 挑选是契约而非过滤:后端导出改 path 后失配 = 构建期报错,不静默缺条。
const starPaths = ["/stars/nobleman", "/stars/peach-blossom", "/stars/travelling-horse", "/stars/academic-star", "/stars/canopy-star"];
const stars = Object.values(g.shensha).filter((e) => starPaths.includes(e.path));
if (stars.length !== starPaths.length) {
  throw new Error(`Footer 神煞挑选失配:期望 ${starPaths.length} 条,terms.json 只匹配到 ${stars.length} 条(后端导出 path 变更后须同步 starPaths)`);
}

// 工具列是站点 UI 文案(排盘器/指南页名),非后端术语——双语内联;
// launch 键对齐 LAUNCH 开关(逐条控制,不同批次可分开发)。
const tools = [
  { p: "/bazi-calculator", name: "BaZi calculator", nameHant: "八字排盤", launch: "tools" },
  { p: "/day-master-calculator", name: "Day Master finder", nameHant: "日主查詢", launch: "tools" },
  { p: "/today", name: "Chinese calendar today", nameHant: "今日黃曆", launch: "tools" },
  { p: "/guides/how-to-read-a-bazi-chart", name: "How to read a chart", nameHant: "如何讀盤", launch: "guides" },
  { p: "/guides/unknown-birth-time", name: "Unknown birth time", nameHant: "時辰未知怎麼辦", launch: "guides" },
  { p: "/guides/true-solar-time", name: "True solar time", nameHant: "真太陽時", launch: "guides" },
  { p: "/about", name: "About & method", nameHant: "關於與方法", launch: "about" },
  { p: "/privacy", name: "Privacy", nameHant: "隱私", launch: "privacy" },
] as const;
const toolName = (x: { name: string; nameHant: string }) => (lang === "en" ? x.name : x.nameHant);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href={langPath(lang, "/")} aria-label={t.homeAria}>
          <svg viewBox="0 0 32 32" aria-hidden="true" style="width:26px;height:26px"><path d="M23.5 6.2A12 12 0 1 0 27.6 19" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
          {lang === "en" ? (
            <span class="brand-word">KNOWFATE</span>
          ) : (
            <span style="display:grid;gap:4px">
              <span class="brand-zh">{brand.word}</span>
              <span class="brand-sub">KNOWFATE</span>
            </span>
          )}
        </a>
        <p class="caption" style="margin-top:18px;max-width:26em">{t.footer.tagline}</p>
        <div style="display:flex;gap:14px;align-items:center;margin-top:20px">
          <span class="seal" style="--size:30px">{brand.seal}</span>
          <span class="micro">knowfate.app</span>
        </div>
      </div>
      <div>
        <h2 class="foot-h">{t.footer.colDayMasters}</h2>
        <ul>
          {/* zh-l 汉字点缀仅 en 渲染(zh-hant 名字本身就是该字,再点缀会「甲甲」) */}
          {dayMasters.map(([key, dm]) => LAUNCH.dayMaster ? (
            <li><a href={P(dm.path)}>{lang === "en" && <span class="zh-l">{dm.zhHant}</span>}{stemName(key, dm)}</a></li>
          ) : (
            <li class="not-launched">{lang === "en" && <span class="zh-l">{dm.zhHant}</span>}{stemName(key, dm)}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="foot-h">{t.footer.colTenGods}</h2>
        <ul>
          {tenGods.map((x) => LAUNCH.tenGods ? (
            <li><a href={P(x.path)}>{nameOf(x)}</a></li>
          ) : (
            <li class="not-launched">{nameOf(x)}</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="foot-h">{t.footer.colElements}</h2>
        <ul>
          {/* 两行五行各占一个 <li>(ul 只允许 li 子节点);灰显同其余列在 li 级
              门控——分隔符 " · " 一并降透明度,不裸留在 li 里 */}
          {[elements.slice(0, 3), elements.slice(3)].map((row) => LAUNCH.fiveElements ? (
            <li>{row.map((e, i) => (<>{i > 0 && " · "}<a href={P(e.path)}>{nameOf(e)}</a></>))}</li>
          ) : (
            <li class="not-launched">{row.map((e, i) => (<>{i > 0 && " · "}{nameOf(e)}</>))}</li>
          ))}
          {stars.map((s) => LAUNCH.stars ? (
            <li><a href={P(s.path)}>{nameOf(s)}</a></li>
          ) : (
            <li class="not-launched">{nameOf(s)}</li>
          ))}
          {LAUNCH.dayPillars ? (
            <li><a href={P("/day-pillars")}>{t.footer.allDayPillars}</a></li>
          ) : (
            <li class="not-launched">{t.footer.allDayPillars}</li>
          )}
        </ul>
      </div>
      <div>
        <h2 class="foot-h">{t.footer.colTools}</h2>
        <ul>
          {tools.map((tool) => LAUNCH[tool.launch] ? (
            <li><a href={P(tool.p)}>{toolName(tool)}</a></li>
          ) : (
            <li class="not-launched">{toolName(tool)}</li>
          ))}
        </ul>
      </div>
    </div>
    <div class="foot-base">
      <span>{t.footer.disclaimer}</span>
      <span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        {" · "}{brand.copyright}
        {" · "}
        <a href={langPath("en", rest)} hreflang="en" aria-current={lang === "en" ? "true" : undefined}>English</a>
        {" · "}
        {/* 繁體中文字样:仅 zh-hant 页面(当前语言)用 .tc;en 页面走 SC 腿,避免 en 页拉 241KB TC 字体 */}
        <a href={langPath("zh-hant", rest)} hreflang="zh-Hant" lang={lang === "en" ? "zh-Hant" : undefined} class={zhFamily(lang)} aria-current={lang === "zh-hant" ? "true" : undefined}>繁體中文</a>
      </span>
    </div>
  </div>
</footer>
