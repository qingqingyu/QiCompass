# 复制为 .env 并填入真实凭据。.env 已在 .gitignore,不会提交。
#
# 加载方式:backend/ 不接 python-dotenv,需 shell 手动 source:
#   set -a; source .env; set +a
#   .venv/bin/uvicorn app.main:app --reload --port 8000

# === Provider 选择(anthropic | openai),默认 anthropic ===
AI_PROVIDER=anthropic

# === Anthropic ===
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# === OpenAI(官方或兼容网关)===
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.5

# === Apple App Store Server API(M2b 后端付费系统)===
# 不填时后端挂 MockAppleServerAPI(所有 transaction_id 都返固定 mock info);
# 填齐 5 项才挂真 AppleServerAPIClient。
#
# 申请步骤(M6 TestFlight 阶段才做):
# 1. App Store Connect > Users and Access > Keys > In-App Purchase
# 2. 生成 API Key,拿到 Key ID + Issuer ID + 下载 .p8 私钥文件
# 3. App Store Connect > My Apps > 你的 App > App Information > Apple ID
#
# 私钥是 ECDSA P-8 PEM 格式,把 .p8 文件内容整段粘贴进来(含 -----BEGIN/END-----)
# APP_STORE_BUNDLE_ID=com.qicompass.app
# APP_STORE_KEY_ID=XXXXXXXXXX
# APP_STORE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----
# APP_STORE_ENVIRONMENT=sandbox
# APP_STORE_APP_APPLE_ID=1234567890

# === Web 并发(不加 gunicorn 依赖,用 uvicorn 原生 --workers)===
# 每个工作进程独立 lifespan / 独立 LLM client / 独立 singleflight 表。
# SQLite WAL 模式下多进程读不阻塞写,并发写依赖 busy_timeout 5s 缓解。
# 2 核 → 2,4 核 → 3-4(留一核给 OS / httpx / asyncio)。
WEB_CONCURRENCY=2

# === 自家 JWT(PR2.5 后端账号系统)===
# 必填,缺失启动失败。本地开发可填任意长字符串;生产用 `openssl rand -hex 32` 生成。
# 不要 commit .env,不要共享密钥给前端。
JWT_SECRET_KEY=dev-secret-change-me-please-1234567890abcdef
# JWT 过期分钟数,默认 30 天(43200 分钟)
# JWT_EXP_MINUTES=43200

# === Sign in with Apple(PR2.5)===
# Bundle ID 作 expected audience(Apple aud claim)。默认读 APP_STORE_BUNDLE_ID。
# APPLE_SIGN_IN_CLIENT_ID=com.qicompass.app
# Apple 公钥缓存 TTL(秒),默认 1 小时
# APPLE_PUBLIC_KEYS_CACHE_TTL=3600

# === Sign in with Google(2026-08-16 起)===
# Google Cloud Console iOS 型 OAuth client 的 CLIENT_ID(xxx.apps.googleusercontent.com)。
# 无默认值:未配置时 provider=google 登录显式 503,Apple 登录不受影响。
# GOOGLE_SIGN_IN_CLIENT_ID=
# Google 公钥缓存 TTL(秒),默认 1 小时
# GOOGLE_PUBLIC_KEYS_CACHE_TTL=3600
