    "onboarding.personality.dog" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loyal and faithful, you commit wholeheartedly. When a friend is in need, you're the first to show up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忠诚念旧，认定了就一心一意；讲义气，朋友有难第一个到。"
          }
        }
      }
    },
    "onboarding.personality.dragon" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You carry an inner compass — once committed, you don't look back. With a natural sense of order, you do things properly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心里有杆秤，认定的事不回头；天生的秩序感，做事要做得漂亮。"
          }
        }
      }
    },
    "onboarding.personality.goat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft-hearted, you can't stand seeing others struggle. With a fine eye for beauty, you turn ordinary days warm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心软细腻，见不得别人为难；审美在线，能把寻常日子过出温度。"
          }
        }
      }
    },
    "onboarding.personality.horse" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm and open, you light up every room. Freedom-loving, you chase your goals with unstoppable drive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "热情坦荡，走到哪都自带气氛；向往自由，追起目标来拦都拦不住。"
          }
        }
      }
    },
    "onboarding.personality.monkey" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick-minded and inventive, you find a way out of any corner. A natural entertainer, you keep every room alive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脑子活，点子多，再难的局面也能转出活路；天生的开心果，有你在不冷场。"
          }
        }
      }
    },
    "onboarding.personality.ox" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow to warm but rock-steady, you take things one solid step at a time. Quiet, yet the one everyone leans on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢热但稳，认准的事一步一个脚印；话不多，却是身边人最靠得住的那一个。"
          }
        }
      }
    },
    "onboarding.personality.pig" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Big-hearted and easygoing, you don't hold grudges — life flows gently. Generous to all, you're the warmth in your circle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心宽福厚，不记仇不较劲，日子过得松弛；对人对己都慷慨，是朋友圈里的暖流。"
          }
        }
      }
    },
    "onboarding.personality.rabbit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle and perceptive, you care for others in quiet ways. Soft on the surface, firm within."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "温和细腻，照顾人于无声处；看似柔软，心里却有自己的坚持。"
          }
        }
      }
    },
    "onboarding.personality.rat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharp-eyed and quick-witted, you see through to the heart of things. Attentive and family-minded, you have a knack for making daily life thrive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "机敏灵动，一眼看穿事情的门道；心思细，顾家，能把小日子盘活。"
          }
        }
      }
    },
    "onboarding.personality.rooster" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharp-eyed and organized, you get things done cleanly. You value standards — and you stand up for the people you care about."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "眼里有活，做事利落不拖泥带水；讲究体面，也肯为在意的人出头。"
          }
        }
      }
    },
    "onboarding.personality.snake" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You think deep and see far, planning before you act. Beneath the calm lies sharp judgment."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想得深，看得远，凡事谋定而后动；安静的外表下，藏着敏锐的判断力。"
          }
        }
      }
    },
    "onboarding.personality.tiger" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A born doer — you see it and you go. Your presence gives people confidence."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
