backend/spikes/prompt_validation/output_v1_chain/

# evalkit 运行产物(可再生,不进 git)。
# 注意:必须内容式忽略(runs/*)——目录式 runs/ 会让 git 不下探该目录,
# 下方 BASELINE 例外(基线指针进 git)永远不生效。
backend/evalkit/runs/*
!backend/evalkit/runs/BASELINE

